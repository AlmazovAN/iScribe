{
  "name": "iscribe",
  "version": "1.0.0",
  "description": "Local browser Russian speech transcription",
  "scripts": {
    "dev": "npm run prepare:engine && vite",
    "typecheck": "npm run prepare:engine && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run prepare:engine && vitest run src scripts",
    "build": "npm run prepare:engine && vite build --mode standalone",
    "build:web": "npm run prepare:engine && vite build --outDir dist-web",
    "serve:isolated": "vite preview --mode isolated --outDir dist-web --host 127.0.0.1 --port 4175 --strictPort",
    "release:check": "node scripts/release-preflight.mjs --standalone",
    "release:check:web": "node scripts/release-preflight.mjs dist-web",
    "prepare:engine": "node scripts/patch-engine.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@yourdevice/engine": "0.1.1",
    "mediabunny": "1.66.4",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "fake-indexeddb": "^6.2.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "private": true
}
